<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Podcast feeds are third-party servers, many still plain HTTP.
         Sync credentials always require HTTPS (enforced in code). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
